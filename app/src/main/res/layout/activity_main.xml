<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WhatsApp AutoResponder"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: checking permission..."
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grant Notification Access"
            android:layout_marginBottom="22dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create an automatic reply rule"
            android:textStyle="bold"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/keywordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Incoming message contains (example: price)"
            android:inputType="text"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/replyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Reply to send"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:gravity="top"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/addRuleButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add / Update Rule"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/rulesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No rules yet."
            android:textSize="14sp"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/clearRulesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear All Rules"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The app replies only when a WhatsApp or WhatsApp Business notification contains one of your saved keywords. Matching is case-insensitive."
            android:textSize="13sp"
            android:layout_marginTop="20dp" />

    </LinearLayout>
</ScrollView>
